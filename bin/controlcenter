#!/bin/sh
# Buka/tutup Quickshell Control Center berdasarkan kondisi nyata di Hyprland.
#
#   controlcenter              toggle
#   controlcenter open sound   buka halaman tertentu
#   controlcenter start        hanya jalankan Quickshell (untuk exec-once)
#
# Simpan di ~/.local/bin/controlcenter lalu: chmod +x ~/.local/bin/controlcenter
# Log: ~/.cache/controlcenter.log

CFG="${QS_CONFIG:-$HOME/.config/quickshell/shell}"
TITLE="Control Center"
LOG="$HOME/.cache/controlcenter.log"

exec 2>>"$LOG"
echo "[$(date +%T)] controlcenter $*" >&2

[ $# -eq 0 ] && set -- toggle

call()    { quickshell -p "$CFG" ipc call controlcenter "$@" >/dev/null; }
running() { quickshell -p "$CFG" ipc show >/dev/null 2>&1; }   # cek tanpa mengubah apa pun
active()  { hyprctl activewindow 2>/dev/null | grep -qx "[[:space:]]*title: $TITLE"; }

# 1. Pastikan Quickshell jalan (tanpa menampilkan window)
if ! running; then
    echo "  quickshell belum jalan, start" >&2
    setsid -f quickshell -p "$CFG" >/dev/null 2>&1 </dev/null
    i=0
    until running; do
        i=$((i + 1))
        [ $i -gt 20 ] && { notify-send "Control Center" "Quickshell gagal start, lihat $LOG"; exit 1; }
        sleep 0.25
    done
fi

[ "$1" = start ] && exit 0

# 2. Aksi
if [ "$1" = toggle ]; then
    if active; then
        call hide
    else
        # tersembunyi / di workspace lain / status basi -> tampilkan di workspace ini
        call hide; sleep 0.1; call show
    fi
else
    active || { call hide; sleep 0.1; }
    call "$@"
fi
